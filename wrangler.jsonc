{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tournament-local",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/t/*"]
  },
  "vars": {"ENVIRONMENT": "local", "PUBLIC_POLL_SECONDS": "300"},
  "d1_databases": [{"binding": "DB", "database_name": "tournament-local", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations"}],
  "observability": {"enabled": true}
}
